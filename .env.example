# Copy to .env. Do not commit real keys.
# LLM: Gemini (Google AI Studio > Get API key). 모델은 비워두면 gemini-3.5-flash-lite (품질이 더 필요하면 gemini-3.6-flash)
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=
# 포스터 배경 그림 모델 (비우면 gemini-3.1-flash-lite-image). 키는 LLM_API_KEY를 같이 쓴다. 이미지 모델은 무료 등급 없음
IMAGE_MODEL=

# 선택: 가공본을 다시 만들 때만. 발급 방법은 docs/submission/install.md
JEJU_HUB_KEY=

MAX_AGENT_STEPS=6
REQUEST_TIMEOUT_SECONDS=30
