# Copy to .env. Do not commit real keys.
# Providers and models are intentionally unset until the team selects them.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
SEARCH_PROVIDER=
SEARCH_API_KEY=

# 네이버 클라우드 콘솔 > NAVER API HUB > Application > 인증 정보 (뉴스 검색 API 추가)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# tavily.com 대시보드 > API Keys (tvly-로 시작)
TAVILY_API_KEY=

JEJU_HUB_KEY=

MAX_AGENT_STEPS=6
REQUEST_TIMEOUT_SECONDS=30
